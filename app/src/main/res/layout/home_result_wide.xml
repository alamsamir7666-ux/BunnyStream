<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube layout home list card: poster card with a 2:3 portrait image
     area so the full movie poster shows uncropped, exactly like the result
     page poster (sized to ~70% of the row width at runtime so the next card
     peeks ~30% behind it, swipe to scroll). Keeps the same view ids as
     home_result_grid.xml so
     SearchResultBuilder can bind it (background_card, imageView, imageText,
     text_rating, text_quality, text_is_dub/sub, episode_text, resume
     progress). Extra ids: wide_image_container, wide_type_chip. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background_card"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    android:elevation="0dp"
    android:foreground="@drawable/outline_drawable"
    app:cardBackgroundColor="@color/yt_card"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 2:3 portrait poster area, height is computed from the card width
             at runtime (matches the poster aspect so nothing is cropped) -->
        <FrameLayout
            android:id="@+id/wide_image_container"
            android:layout_width="match_parent"
            android:layout_height="420dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/search_poster_img_des"
                android:duplicateParentState="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />

            <FrameLayout
                android:id="@+id/watch_progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/search_item_download_play"
                    style="@style/HomePlayUnderlayProgress" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/watchProgress"
                    style="@style/HomeCircularProgress"
                    tools:progress="50" />
            </FrameLayout>

            <TextView
                android:id="@+id/episode_text"
                style="@style/EpisodeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp" />

            <!-- Dub/Sub/flag pills stacked on the image right edge like the
                 poster card, styled by SearchResultBuilder at runtime -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_is_dub"
                    style="@style/DubButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_is_sub"
                    style="@style/SubButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_flag"
                    style="@style/SearchBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@color/transparent"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:text="🇸🇪" />
            </LinearLayout>
        </FrameLayout>

        <!-- Title + meta: star rating, type chip, quality chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/imageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Spider-Man: Brand New Day" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_rating"
                    style="@style/YouTubeRatingChip"
                    tools:text="7.9" />

                <TextView
                    android:id="@+id/wide_type_chip"
                    style="@style/YouTubeTagChip"
                    tools:text="Movie" />

                <TextView
                    android:id="@+id/text_quality"
                    style="@style/YouTubeTagChip"
                    tools:text="HD" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
